@article{kalidindiRdmcacfc2021,
  title = {Rotational Dynamics in Motor Cortex Are Consistent with a Feedback Controller},
  author = {Kalidindi, Hari Teja and Cross, Kevin P and Lillicrap, Timothy P and Omrani, Mohsen and Falotico, Egidio and Sabes, Philip N and Scott, Stephen H},
  editor = {Goldberg, Jesse H and Ivry, Richard B},
