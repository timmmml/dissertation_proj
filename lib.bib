}

@article{mishatsodyksAttractorNeuralNetwork1999,
  title = {Attractor Neural Network Models of Spatial Maps in Hippocampus.},
  author = {{Misha Tsodyks} and Tsodyks, Misha},
  date = {1999-01-01},
  journaltitle = {Hippocampus},
  volume = {9},
