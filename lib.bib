@article{jeffreym.zacksNeuroimagingStudiesMental2008,
  title = {Neuroimaging Studies of Mental Rotation: {{A}} Meta-Analysis and Review},
  author = {{Jeffrey M. Zacks} and Zacks, Jeffrey M.},
