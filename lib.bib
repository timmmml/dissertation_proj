@article{changNovoMotorLearning2024,
  title = {De Novo Motor Learning Creates Structure in Neural Activity That Shapes Adaptation},
  author = {Chang, Joanna C. and Perich, Matthew G. and Miller, Lee E. and Gallego, Juan A. and Clopath, Claudia},
  date = {2024-05-14},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {15},
  number = {1},
  pages = {4084},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-48008-7},
  url = {https://www.nature.com/articles/s41467-024-48008-7},
  urldate = {2024-11-25},
  abstract = {Abstract             Animals can quickly adapt learned movements to external perturbations, and their existing motor repertoire likely influences their ease of adaptation. Long-term learning causes lasting changes in neural connectivity, which shapes the activity patterns that can be produced during adaptation. Here, we examined how a neural population’s existing activity patterns, acquired through de novo learning, affect subsequent adaptation by modeling motor cortical neural population dynamics with recurrent neural networks. We trained networks on different motor repertoires comprising varying numbers of movements, which they acquired following various learning experiences. Networks with multiple movements had more constrained and robust dynamics, which were associated with more defined neural ‘structure’—organization in the available population activity patterns. This structure facilitated adaptation, but only when the changes imposed by the perturbation were congruent with the organization of the inputs and the structure in neural activity acquired during de novo learning. These results highlight trade-offs in skill acquisition and demonstrate how different learning experiences can shape the geometrical properties of neural population activity and subsequent adaptation.},
  langid = {english},
  file = {/home/timmy/Zotero/storage/SRIBKA3S/Chang et al. - 2024 - De novo motor learning creates structure in neural.pdf}
